#!/bin/bash

# 当期版本
export VERSION="|V1.1.0|App_ROS2_1.0|2026-02-06|"

# 雷达类型：/LD19
export LIDAR_TYPE=LD19

# 摄像头类型：aurora/usb_cam
export DEPTH_CAMERA_TYPE=aurora

# 机器类型：ROSPider
export MACHINE_TYPE=ROSpider

# 主从机设置：robot_xxx
export HOST=/ #robot_1
export MASTER=/ #robot_1

# 语言设置，主要涉及语音部分：Chinese/English
export ASR_LANGUAGE=English

# 大模型类型设置：online/offline
export ASR_MODE=online

# Voice is sherpa-onnx (see ros2_ws/info/voice.md). MIC_TYPE is unused by the voice launch.
export MIC_TYPE=usb

export need_compile=False
#export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export ROS_DOMAIN_ID=27 # Numbers from 0 to 232
export CYCLONEDDS_URI=file:///etc/cyclonedds/config.xml
export BRINGUP_JOYSTICK=true
# slim = motion+sensors (default). full = vendor phone/demo tree.
export BRINGUP_PROFILE=slim
# Boot the sherpa voice stack (Hello Masha → commands). See ros2_ws/info/voice.md.
export BRINGUP_VOICE=true

echo -e "\033[32m----------------------------------------------
当前环境是ROS2|The current environment is ROS2
----------------------------------------------\033[0m"
echo -e "|LIDAR|CAMERA|MIC|ASR|: \033[32m|$LIDAR_TYPE|$DEPTH_CAMERA_TYPE|$MIC_TYPE|$ASR_MODE|\033[0m"
echo -e "BRINGUP_PROFILE: \033[32m$BRINGUP_PROFILE\033[0m"
echo -e "MACHINE: \033[32m$MACHINE_TYPE\033[0m"
echo -e "HOST:    \033[32m$HOST\033[0m"
echo -e "MASTER:  \033[32m$MASTER\033[0m"
echo -e "ROS_DOMAIN_ID: \033[32m$ROS_DOMAIN_ID\033[0m"
echo -e "VERSION: \033[32m$VERSION\033[0m"
