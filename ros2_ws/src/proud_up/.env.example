# Copy to .env on the robot and fill in real mailbox details.
# .env is gitignored and loaded by proud_up_node at start.

MASHA_SMTP_HOST=smtp.example.com
MASHA_SMTP_PORT=587
MASHA_SMTP_USER=masha@example.com
MASHA_SMTP_PASSWORD=replace-me
MASHA_SMTP_FROM=masha@example.com
MASHA_SMTP_TO=peter@example.com
MASHA_SMTP_ENCRYPTION=starttls
