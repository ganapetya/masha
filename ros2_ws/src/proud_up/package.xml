<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>proud_up</name>
  <version>0.1.0</version>
  <description>
    Boot node: wait until Masha is ready, straighten the arm so the camera looks
    forward, capture one frame, and email it with subject "Masha is up".
  </description>
  <maintainer email="ubuntu@todo.todo">ubuntu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>kinematics_msgs</depend>
  <depend>std_srvs</depend>
  <depend>cv_bridge</depend>
  <depend>servo_controller_msgs</depend>
  <build_depend>eigen3_cmake_module</build_depend>
  <depend>eigen</depend>
  <depend>libcurl4-openssl-dev</depend>
  <depend>libopencv-dev</depend>
  <depend>ament_index_cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
