[Unit]
Description=LogosKittens body for Masha
After=network-online.target

[Service]
Type=simple
Environment=ROS_DOMAIN_ID=27
EnvironmentFile=-/home/ubuntu/ros2_ws/src/lk_body/.env
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/ubuntu/ros2_ws/install/setup.bash && export ROS_DOMAIN_ID=27 && exec ros2 run lk_body lk_body_node'
Restart=no

[Install]
WantedBy=default.target
